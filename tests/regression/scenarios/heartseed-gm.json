{
  "name": "heartseed-gm",
  "timeout_seconds": 120,
  "args": [
    "--cmd",
    "play",
    "--hold",
    "1"
  ],
  "steps": [
    "say .heartseed revoke",
    "say .heartseed info",
    "say .heartseed grant",
    "say .heartseed info",
    "say .heartseed growth +700",
    "say .heartseed points spend stam 1",
    "say .heartseed points spend main",
    "say .list auras",
    "say .seed spend crit",
    "say .seed reset",
    "say .heartseed points reset",
    "say .heartseed growth 0",
    "say .quest remove 9247",
    "say .quest remove 7889",
    "say .quest add 9247",
    "say .quest complete 9247",
    "say .quest reward 9247",
    "say .heartseed growth",
    "say .quest add 7889",
    "say .quest complete 7889",
    "say .quest reward 7889",
    "say .heartseed growth",
    "say .quest remove 9247",
    "say .quest remove 7889",
    "say .heartseed flag set first_dungeon",
    "say .heartseed flag clear first_dungeon",
    "say .heartseed essence add 1",
    "say .heartseed essence slot 1 1",
    "say .heartseed revoke",
    "say .heartseed info"
  ],
  "assertions": [
    {
      "type": "regex",
      "pattern": "(?s)step: say .quest reward 9247.*?step: say .heartseed growth\b.*?Growth of Seedtest: level 0, 15 of 300 XP.*?step: say .quest reward 7889.*?step: say .heartseed growth\b.*?Growth of Seedtest: level 0, 15 of 300 XP"
    },
    {
      "type": "contains",
      "text": "LOGIN-OK map="
    },
    {
      "type": "event",
      "kind": "login",
      "minimum": 1,
      "maximum": 1
    },
    {
      "type": "contains",
      "text": "Granted a Heartseed to"
    },
    {
      "type": "contains",
      "text": "Heartseed of"
    },
    {
      "type": "contains",
      "text": "dominant path"
    },
    {
      "type": "regex",
      "pattern": "(?s)step: say .heartseed growth \\+700.*?Growth level 2\\. 2 stat points to spend.*?Growth of Seedtest: level 2, 50 of 400 XP"
    },
    {
      "type": "regex",
      "pattern": "(?s)step: say .heartseed points spend main.*? 1 Stamina: 1 points, \\+1% \\(spell 310010\\).*? 2 Main stat: 1 points, \\+1% \\(spell 3100(11|12|13)\\)"
    },
    {
      "type": "regex",
      "pattern": "(?s)step: say .list auras.*?id: 310010.*?step: say .seed spend crit"
    },
    {
      "type": "regex",
      "pattern": "(?s)step: say .seed spend crit.*?no stat points to spend.*?step: say .seed reset.*?Only a Celestial shrine.*?step: say .heartseed points reset.*?Reset: done\\."
    },
    {
      "type": "contains",
      "text": "Story flag 1 (first_dungeon) set"
    },
    {
      "type": "contains",
      "text": "Story flag 1 (first_dungeon) cleared"
    },
    {
      "type": "contains",
      "text": "Essence 1 added for"
    },
    {
      "type": "contains",
      "text": "Essence 1 slotted for"
    },
    {
      "type": "contains",
      "text": "Removed the Heartseed of"
    },
    {
      "type": "not_contains",
      "text": "SESSION-TIMEOUT"
    },
    {
      "type": "not_contains",
      "text": "Traceback (most recent call last)"
    }
  ]
}
