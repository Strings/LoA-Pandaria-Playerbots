{
  "name": "taxi-speed",
  "timeout_seconds": 60,
  "args": ["--cmd", "play", "--hold", "1"],
  "steps": [
    "say .mountspeed"
  ],
  "assertions": [
    {"type": "contains", "text": "LOGIN-OK map="},
    {"type": "contains", "text": "Flight paths: 118.2 yd/s (Taxi.SpeedOfTopFlight=2.00; top player flying 59.1 yd/s; stock 32)"},
    {"type": "not_contains", "text": "SESSION-TIMEOUT"}
  ]
}
