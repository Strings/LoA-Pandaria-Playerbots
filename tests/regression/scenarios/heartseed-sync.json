{
  "name": "heartseed-sync",
  "timeout_seconds": 120,
  "args": [
    "--cmd",
    "play",
    "--hold",
    "1"
  ],
  "steps": [
    "say .heartseed revoke",
    "say .seed sync",
    "say .heartseed grant",
    "say .heartseed essence add 1",
    "say .seed sync",
    "say .heartseed revoke"
  ],
  "assertions": [
    {
      "type": "contains",
      "text": "LOGIN-OK map="
    },
    {
      "type": "event",
      "kind": "login",
      "minimum": 1,
      "maximum": 1
    },
    {
      "type": "contains",
      "text": "msg=\"N\""
    },
    {
      "type": "contains",
      "text": "msg=\"S"
    },
    {
      "type": "contains",
      "text": "Sprout"
    },
    {
      "type": "contains",
      "text": "msg=\"M"
    },
    {
      "type": "contains",
      "text": "Sha-touched Essence"
    },
    {
      "type": "contains",
      "text": "msg=\"E\""
    },
    {
      "type": "not_contains",
      "text": "SESSION-TIMEOUT"
    },
    {
      "type": "not_contains",
      "text": "Traceback"
    }
  ]
}
