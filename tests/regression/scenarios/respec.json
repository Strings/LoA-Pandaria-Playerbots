    {
      "type": "contains",
      "text": "Respec: free gold="
    },
    {
      "type": "contains",
      "text": "Respec talent 15775: learned="
    },
    {
      "type": "contains",
      "text": "Respec reset: success="
    },
    {
      "type": "contains",
      "text": "Respec requested normal cast 113873 with index 0"
    }
  ]
