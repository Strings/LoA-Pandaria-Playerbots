{
  "name": "heartseed-riders",
  "timeout_seconds": 180,
  "args": [
    "--cmd",
    "play",
    "--hold",
    "2"
  ],
  "steps": [
    "say .revive",
    "say .go -9339.7 170.2 61.6 0",
    "say .heartseed revoke",
    "say .heartseed grant",
    "say .character level Seedtest 85",
    "say .cooldown",
    "say .heartseed major 1 6",
    "say .heartseed info",
    "say .npc add temp 6",
    "say .npc add temp 6",
    "cast 310102",
    "wait-for evt=never timeout=1",
    "say .heartseed meter hit 50000",
    "cast 310102",
    "say .list auras",
    "say .heartseed major 1 4",
    "say .heartseed meter 5",
    "cast 310101",
    "say .list auras",
    "say .heartseed info",
    "say .heartseed major 1 2",
    "say .npc add temp 6",
    "npcguid 6",
    "cast 310100 npc",
    "wait-for evt=never timeout=1",
    "say .list auras",
    "say .heartseed revoke",
    "say .character level Seedtest 10"
  ],
  "assertions": [
    {
      "type": "contains",
      "text": "LOGIN-OK map="
    },
    {
      "type": "contains",
      "text": "riders: stage 0 kind 11 amount 30, stage 2 kind 5 amount -20, stage 3 kind 7 amount 50, stage 4 kind 10 amount 2000."
    },
    {
      "type": "regex",
      "pattern": "(?s)step: cast 310102.*?SMSG_CAST_FAILED spell=310102.*?step: say .heartseed meter hit 50000.*?Meter of Seedtest: stacks 0/0, lit yes"
    },
    {
      "type": "regex",
      "pattern": "(?s)step: say .heartseed meter hit 50000.*?step: cast 310102.*?id: 310112.*?step: cast 310101.*?id: 310111.*?last spend 5 stacks.*?step: cast 310100.*?310110"
    },
    {
      "type": "not_contains",
      "text": "SESSION-TIMEOUT"
    },
    {
      "type": "not_contains",
      "text": "Traceback"
    }
  ]
}
