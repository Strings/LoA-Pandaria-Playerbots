{
  "name": "heartseed-riders",
  "timeout_seconds": 180,
  "args": [
    "--cmd",
    "play",
    "--hold",
    "2"
  ],
  "steps": [
    "say .revive",
    "say .go -9339.7 170.2 61.6 0",
    "say .heartseed revoke",
    "say .heartseed grant",
    "say .character level Seedtest 85",
    "say .cooldown",
    "say .heartseed major 10 6",
    "say .heartseed info",
    "say .npc add temp 6",
    "say .npc add temp 6",
    "cast 116098",
    "wait-for evt=never timeout=1",
    "say .heartseed meter lit",
    "cast 116098",
    "wait-for evt=never timeout=1",
    "say .list auras",
    "say .heartseed major 10 4",
    "say .heartseed meter 5",
    "cast 148009",
    "wait-for evt=never timeout=1",
    "say .heartseed info",
    "say .list auras",
    "say .heartseed major 10 2",
    "say .npc add temp 6",
    "npcguid 6",
    "cast 123904 npc",
    "wait-for evt=never timeout=1",
    "say .list auras",
    "say .heartseed revoke",
    "say .character level Seedtest 10"
  ],
  "assertions": [
    {
      "type": "contains",
      "text": "LOGIN-OK map="
    },
    {
      "type": "contains",
      "text": "riders: stage 1 kind 11 amount 30, stage 2 kind 5 amount -20, stage 3 kind 7 amount 50, stage 4 kind 10 amount 2000."
    },
    {
      "type": "regex",
      "pattern": "(?s)step: cast 116098.*?SMSG_CAST_FAILED spell=116098.*?step: say .heartseed meter lit.*?Meter of Seedtest: stacks 0/0, lit yes"
    },
    {
      "type": "regex",
      "pattern": "(?s)step: say .heartseed meter lit.*?step: cast 116098.*?11426.*?step: cast 148009.*?last spend 5 stacks.*?2983.*?step: cast 123904.*?26297"
    },
    {
      "type": "not_contains",
      "text": "SESSION-TIMEOUT"
    },
    {
      "type": "not_contains",
      "text": "Traceback"
    }
  ]
}
